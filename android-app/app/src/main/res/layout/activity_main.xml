<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10131c"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="File Viewer"
        android:textColor="#F3F5FA"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Deschide și împărtășește fișiere de pe telefon"
        android:textColor="#AAB3C7"
        android:textSize="14sp" />

    <Button
        android:id="@+id/selectFileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#9C8CFF"
        android:text="Alege fișier"
        android:textColor="#10131c" />

    <TextView
        android:id="@+id/infoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="#171B27"
        android:padding="12dp"
        android:textColor="#F3F5FA"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/shareButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#1D2230"
            android:text="Trimite"
            android:textColor="#F3F5FA" />

        <Button
            android:id="@+id/openExternalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#1D2230"
            android:text="Deschide"
            android:textColor="#F3F5FA" />
    </LinearLayout>

    <ImageView
        android:id="@+id/previewImage"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="18dp"
        android:background="#0F131B"
        android:contentDescription="Preview image"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/previewText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:background="#0F131B"
        android:padding="12dp"
        android:textColor="#DDE3F5"
        android:textIsSelectable="true"
        android:textSize="13sp"
        android:scrollbars="vertical"
        android:visibility="gone" />

</LinearLayout>
